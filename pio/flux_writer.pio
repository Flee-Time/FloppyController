.program flux_writer

; FIFO: half-cell count minus one, then MSB-first half-cell words.
; At 20 MHz both paths take 20 cycles = 1 us per half-cell.
; Transitions pulse WDATA LOW for 4 cycles = 200 ns.
; Completion IRQ is relative to the SM number, after the final half-cell.
    pull block
    out y, 32

.wrap_target
bitloop:
    out x, 1              ; 1 cycle
    jmp !x, no_pulse      ; 1 cycle
    set pins, 0 [3]       ; 4 cycles LOW
    set pins, 1 [11]      ; 12 cycles HIGH
    jmp bit_done          ; 1 cycle: do not fall through into no_pulse
no_pulse:
    nop [16]              ; 17 cycles HIGH
bit_done:
    jmp y--, bitloop      ; 1 cycle (both paths total 20)
    irq 0 rel             ; complete stream emitted, WDATA HIGH
halt:
    jmp halt
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void flux_writer_program_init(PIO pio, uint sm, uint offset,
                                             uint pin_wdata) {
    pio_sm_config c = flux_writer_program_get_default_config(offset);

    sm_config_set_set_pins(&c, pin_wdata, 1);
    sm_config_set_out_shift(&c, false, true, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, (float)clock_get_hz(clk_sys) / 20000000.0f);
    pio_gpio_init(pio, pin_wdata);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_consecutive_pindirs(pio, sm, pin_wdata, 1, true);
    pio_sm_set_pins_with_mask(pio, sm, 1u << pin_wdata, 1u << pin_wdata);
}
%}
